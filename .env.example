# ==========================================
# DocuMind AI Environment Configuration
# ==========================================

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://documind:documind_secret@localhost:5432/documind_db
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_secret
POSTGRES_DB=documind_db
POSTGRES_PORT=5432

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads

# Embedding Model Configuration
# Model: sentence-transformers/all-MiniLM-L6-v2 (Vector dimension: 384)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Reranker Configuration (Optional Cross-Encoder)
ENABLE_RERANKER=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=20
RERANK_TOP_K=5

# LLM Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
